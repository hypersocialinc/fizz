fizz score v1
# Arcade Sequence: a fast chiptune loop in E minor (upgraded from the arcade-sequence seed).
# Shows: fast lines on oscillators, a half-bar phrase moved through the chords,
# crush for an 8-bit edge, and a modulation up a whole step for the last section.
bpm 140
key E minor
form: level level boss

phrase run = 1 3 5 1' 5 3 1 .

section "level" bars=4
  chords: i VI VII V
  kick 909_bd : x... x... x... x...
  snare 909_sd :
    1| .... x... .... x...
    2| .... x... .... x.xr
  hat 909_hh : x.x. x.x. x.x. x.X.
  bass square octave=1 crush=6 :
    1| x.x. x.x. x.x. x.xx
    2| x.x. x.x. x..x x.x.
  lead#run square_lead crush=8 :
    1| $run $run
    2| $run+5 6 . 1' . 3' . . .
    3| $run+6 $run+6
    4| $run+4 #7 . 2' . 5' _ _ _

section "boss" from=level key=F#
  #kick : x... x... x... x.xx
  fx#rise pink ramp=hpf,500,9000 ramp=gain,0.1,0.5 :
    1| x___ ____ ____ ____
    2| ____ ____ ____ ____

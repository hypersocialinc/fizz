fizz score v1
# Trap Night: a trap song in G minor. Shows the trap form (intro verse hook verse hook outro),
# a hook built from the verse with a busier kick and a pad only it has, and an intro and
# outro that drop the drums.
bpm 140
key G minor
arrangement: intro verse hook verse hook outro

section "verse" bars=8
  chords: i:2 VI:2 iv:2 V:2
  kick 808_bd gain=0.9 :
    1| x... ...x ..x. ....
    2| x... .... x.x. .x..
  snare 808_sd gain=0.6 room=0.1 : .... x... .... x.r.
  hat 808_hh steps=32 gain=0.3 hpf=400 :
    1| x.x.x.x. x.x.x.x. x.x.xxxx x.x.x.x.
    2| x.x.x.x. x.x.x.x. xxxxxxxx x.x.x.x.
  bass sine octave=1 gain=0.7 lpf=200 :
    1| x___ ___x ..x_ ....
    2| x___ .... x.x_ .x..
  lead bells octave=4 gain=0.3 room=0.5 delay=0.35 :
    1| 5 . . . 4 . . . 3 . 1 . . . . .
    2| 5 . . . 3 . . . 1 . . . #7, . . .
    3| 3 . . . 1 . . . 6, . 5, . . . . .
    4| 3 . . . 1 . . . 6, . . . 7, . . .
    5| 6 . . . 4 . . . 1 . 7, . . . . .
    6| 6 . . . 4 . . . 1 . . . 2 . . .
    7| 5 . . . 3 . . . 2 . 1 . . . . .
    8| 5 . . . 3 . . . #7, . . . 1 . . .

section "hook" from=verse
  #kick :
    1| x..x ...x ..x. ..x.
    2| x... ..x. x.x. .xx.
  pad warm_pad octave=3 gain=0.25 presence=back : x___ ____ ____ ____

section "intro" from=verse bars=4 drop=kick,snare,bass,lead
  chords: i:2 VI:2
  pad warm_pad octave=3 gain=0.25 presence=back : x___ ____ ____ ____

section "outro" from=intro drop=hat
  chords: iv:2 i:2

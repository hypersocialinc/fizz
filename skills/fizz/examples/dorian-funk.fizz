fizz score v1
# Dorian Funk: a funk groove in E dorian, grown into a short song. Shows a groove written
# once and reused: an intro without the kick, snare and horn line, a break on new chords
# without the bass, and an outro that keeps only the break's keys and pad.
bpm 100
key E dorian
swing 0.2
arrangement: intro groove break groove outro

section "groove" bars=4
  chords: i7:2 IV7:2
  kick kit_bd gain=0.9 :
    1| x... ..x. ..x. ....
    2| x..x ..x. .... ..x.
  snare kit_sd gain=0.6 : .... X..r .x.. X...
  hat kit_hh gain=0.35 hpf=500 : x <x .> x. xxxx x.x. xxxx
  hat#shaker perc_sh steps=12 gain=0.25 pan=0.7 : x.x x.x x.x x.x
  bass pick_bass octave=2 gain=0.7 lpf=1800 :
    1| 1 . 1' . . 5 . 7 1 . . 3' . 1' [5 4] .
    2| 1 . . 1' . 5 . . 1 . 3' . 1' . [7 5] .
    3| 4 . 4' . . 1' . 3' 4 . . 6' . 4' [1' 7] .
    4| 4 . . 4' . 1' . . 4 . 6' . 4' . [3' 1'] .
  chords clav octave=3 gain=0.4 hpf=250 : .x.x ..x. .x.. x.x.
  lead brass octave=4 gain=0.35 room=0.25 :
    1| . . . . 5 . 7 1' . . 7 . 5 . . .
    2| . . . . . . . . 1' . 7 1' . 7 5 .

section "intro" from=groove drop=kick,snare,lead

section "break" from=groove drop=kick,bass,lead
  chords: IV7:2 VII:2
  pad warm_pad octave=3 gain=0.25 presence=back : x___ ____ ____ ____

section "outro" from=break drop=snare,hat,shaker
  chords: i7:2 IV7:2
